# Local-only Docker Compose placeholders.
# Copy to .env for personal overrides. Do not put production secrets here.

COMPOSE_PROJECT_NAME=ecommerce-local

GATEWAY_SERVICE_HOST_PORT=8080
CATALOG_SERVICE_HOST_PORT=8081
ORDER_SERVICE_HOST_PORT=8082
PAYMENT_SERVICE_HOST_PORT=8083
AUDIT_NOTIFICATION_SERVICE_HOST_PORT=8084
MOCK_PAYMENT_PROVIDER_HOST_PORT=8089

POSTGRES_PORT=5432
POSTGRES_USER=ecommerce
POSTGRES_PASSWORD=change-me-local-postgres
POSTGRES_DB=ecommerce

CATALOG_SERVICE_CONTAINER_DB_URL=jdbc:postgresql://postgres:5432/catalog
CATALOG_DB_USERNAME=ecommerce
CATALOG_DB_PASSWORD=change-me-local-postgres
ORDER_SERVICE_CONTAINER_DATASOURCE_URL=jdbc:postgresql://postgres:5432/orders
ORDER_SERVICE_DATASOURCE_USERNAME=ecommerce
ORDER_SERVICE_DATASOURCE_PASSWORD=change-me-local-postgres
ORDER_SERVICE_CONTAINER_CATALOG_BASE_URL=http://catalog-service:8081
PAYMENT_SERVICE_CONTAINER_DATASOURCE_URL=jdbc:postgresql://postgres:5432/payments
PAYMENT_SERVICE_DATASOURCE_USERNAME=ecommerce
PAYMENT_SERVICE_DATASOURCE_PASSWORD=change-me-local-postgres
PAYMENT_SERVICE_CONTAINER_MOCK_PROVIDER_BASE_URL=http://mock-payment-provider:8089
PAYMENT_SERVICE_MOCK_PROVIDER_AUTHORIZE_PATH=/api/mock-payments/authorize
PAYMENT_SERVICE_MOCK_PROVIDER_CONNECT_TIMEOUT=PT2S
PAYMENT_SERVICE_MOCK_PROVIDER_READ_TIMEOUT=PT3S

ECOMMERCE_CONTAINER_CATALOG_SERVICE_URI=http://catalog-service:8081
ECOMMERCE_CONTAINER_ORDER_SERVICE_URI=http://order-service:8082
ECOMMERCE_CONTAINER_PAYMENT_SERVICE_URI=http://payment-service:8083
ECOMMERCE_CONTAINER_AUDIT_NOTIFICATION_SERVICE_URI=http://audit-notification-service:8084

REDIS_PORT=6379
REDIS_CONTAINER_HOST=redis
REDIS_CONTAINER_PORT=6379
REDIS_PASSWORD=change-me-local-redis
REDIS_DATABASE=0
REDIS_TIMEOUT=PT2S
REDIS_CONNECT_TIMEOUT=PT2S
CATALOG_CACHE_ENABLED=true
CATALOG_PRODUCT_DETAIL_CACHE_TTL=PT10M
CATALOG_PRODUCT_DETAIL_CACHE_LOCK_WAIT=PT0.25S
CATALOG_PRODUCT_DETAIL_CACHE_LOCK_LEASE=PT5S
CATALOG_PRODUCT_DETAIL_CACHE_KEY_PREFIX=catalog:product-detail
CATALOG_SUPPLIER_IMPORT_CHUNK_SIZE=50
CATALOG_SUPPLIER_IMPORT_DIRECTORY=var/catalog/imports

KAFKA_PORT=9092
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CONTAINER_BOOTSTRAP_SERVERS=kafka:9092
PAYMENT_SERVICE_ORDER_CREATED_TOPIC=ecommerce.order.events
PAYMENT_SERVICE_ORDER_CREATED_GROUP_ID=payment-service.order-created.v1
PAYMENT_SERVICE_ORDER_CREATED_CONSUMER_ENABLED=true
PAYMENT_SERVICE_ORDER_CREATED_RETRY_MAX_ATTEMPTS=3
PAYMENT_SERVICE_ORDER_CREATED_RETRY_BACKOFF=PT1S
PAYMENT_SERVICE_ORDER_CREATED_DLT_TOPIC=ecommerce.order.events.DLT
ORDER_SERVICE_PAYMENT_RESULT_TOPIC=ecommerce.payment.events
ORDER_SERVICE_PAYMENT_RESULT_GROUP_ID=order-service.payment-results.v1
ORDER_SERVICE_PAYMENT_RESULT_CONSUMER_ENABLED=true
ORDER_SERVICE_PAYMENT_RESULT_RETRY_MAX_ATTEMPTS=3
ORDER_SERVICE_PAYMENT_RESULT_RETRY_BACKOFF=PT1S
ORDER_SERVICE_PAYMENT_RESULT_DLT_TOPIC=ecommerce.payment.events.DLT
DEBEZIUM_CONNECT_PORT=8086
DEBEZIUM_CONNECT_URL=http://localhost:8086
DEBEZIUM_BOOTSTRAP_CONNECT_URL=http://debezium-connect:8083
DEBEZIUM_BOOTSTRAP_TIMEOUT_SECONDS=180
DEBEZIUM_CONNECTOR_READY_TIMEOUT_SECONDS=180
DEBEZIUM_BOOTSTRAP_POLL_SECONDS=2
DEBEZIUM_BOOTSTRAP_CURL_TIMEOUT_SECONDS=30
DEBEZIUM_ORDER_DB_HOST=postgres
DEBEZIUM_ORDER_DB_PORT=5432
DEBEZIUM_ORDER_DB_USER=ecommerce
DEBEZIUM_ORDER_DB_PASSWORD=change-me-local-postgres
DEBEZIUM_ORDER_DB_NAME=orders
DEBEZIUM_ORDER_TOPIC_PREFIX=ecommerce.order.outbox.v1
DEBEZIUM_ORDER_SLOT_NAME=order_outbox_slot_v1
DEBEZIUM_ORDER_PUBLICATION_NAME=order_outbox_publication_v1
ORDER_OUTBOX_CONNECTOR_FILE=infra/debezium/order-outbox-connector.json
ORDER_OUTBOX_TOPIC=ecommerce.order.events
ORDER_CDC_SMOKE_TIMEOUT_MS=60000
ORDER_CDC_SMOKE_MAX_MESSAGES=200
DEBEZIUM_PAYMENT_DB_HOST=postgres
DEBEZIUM_PAYMENT_DB_PORT=5432
DEBEZIUM_PAYMENT_DB_USER=ecommerce
DEBEZIUM_PAYMENT_DB_PASSWORD=change-me-local-postgres
DEBEZIUM_PAYMENT_DB_NAME=payments
DEBEZIUM_PAYMENT_TOPIC_PREFIX=ecommerce.payment.outbox.v1
DEBEZIUM_PAYMENT_SLOT_NAME=payment_outbox_slot_v1
DEBEZIUM_PAYMENT_PUBLICATION_NAME=payment_outbox_publication_v1
PAYMENT_OUTBOX_CONNECTOR_FILE=infra/debezium/payment-outbox-connector.json
PAYMENT_OUTBOX_TOPIC=ecommerce.payment.events
PAYMENT_CDC_SMOKE_TIMEOUT_MS=60000
PAYMENT_CDC_SMOKE_MAX_MESSAGES=200

MONGO_PORT=27017
MONGO_INITDB_ROOT_USERNAME=ecommerce
MONGO_INITDB_ROOT_PASSWORD=change-me-local-mongo
MONGO_INITDB_DATABASE=audit
AUDIT_NOTIFICATION_CONTAINER_MONGODB_HOST=mongodb
AUDIT_NOTIFICATION_CONTAINER_MONGODB_PORT=27017
AUDIT_NOTIFICATION_MONGODB_DATABASE=audit
AUDIT_NOTIFICATION_MONGODB_USERNAME=ecommerce
AUDIT_NOTIFICATION_MONGODB_PASSWORD=change-me-local-mongo
AUDIT_NOTIFICATION_MONGODB_AUTHENTICATION_DATABASE=admin
AUDIT_NOTIFICATION_MONGODB_AUTO_INDEX_CREATION=true
AUDIT_NOTIFICATION_ORDER_CREATED_TOPIC=ecommerce.order.events
AUDIT_NOTIFICATION_ORDER_CREATED_GROUP_ID=audit-notification-service.order-created.v1
AUDIT_NOTIFICATION_ORDER_CREATED_CONSUMER_ENABLED=true
AUDIT_NOTIFICATION_ORDER_CREATED_RETRY_MAX_ATTEMPTS=3
AUDIT_NOTIFICATION_ORDER_CREATED_RETRY_BACKOFF=PT1S
AUDIT_NOTIFICATION_ORDER_CREATED_DLT_TOPIC=ecommerce.order.events.audit.DLT
AUDIT_NOTIFICATION_PAYMENT_RESULTS_TOPIC=ecommerce.payment.events
AUDIT_NOTIFICATION_PAYMENT_RESULTS_GROUP_ID=audit-notification-service.payment-results.v1
AUDIT_NOTIFICATION_PAYMENT_RESULTS_CONSUMER_ENABLED=true
AUDIT_NOTIFICATION_PAYMENT_RESULTS_RETRY_MAX_ATTEMPTS=3
AUDIT_NOTIFICATION_PAYMENT_RESULTS_RETRY_BACKOFF=PT1S
AUDIT_NOTIFICATION_PAYMENT_RESULTS_DLT_TOPIC=ecommerce.payment.events.audit.DLT
AUDIT_NOTIFICATION_EMAIL_ENABLED=true
AUDIT_NOTIFICATION_EMAIL_MAX_ATTEMPTS=3
AUDIT_NOTIFICATION_EMAIL_BATCH_SIZE=50
AUDIT_NOTIFICATION_PUSH_ENABLED=true
AUDIT_NOTIFICATION_PUSH_MAX_ATTEMPTS=3
AUDIT_NOTIFICATION_PUSH_BATCH_SIZE=50
AUDIT_NOTIFICATION_DLT_DEPTH_ENABLED=true
AUDIT_NOTIFICATION_DLT_DEPTH_REFRESH_INTERVAL=PT30S
AUDIT_NOTIFICATION_DLT_DEPTH_TIMEOUT=PT2S

KEYCLOAK_PORT=8085
KEYCLOAK_MANAGEMENT_PORT=9000
KEYCLOAK_DB=keycloak
KEYCLOAK_REALM=ecommerce
KEYCLOAK_ISSUER_URI=http://localhost:8085/realms/ecommerce
ECOMMERCE_SECURITY_ISSUER_URI=http://localhost:8085/realms/ecommerce
ECOMMERCE_CONTAINER_SECURITY_JWK_SET_URI=http://keycloak:8080/realms/ecommerce/protocol/openid-connect/certs
KEYCLOAK_GATEWAY_CLIENT=ecommerce-gateway
KEYCLOAK_LOCAL_TEST_CLIENT=ecommerce-local-test
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-local-keycloak

MOCK_PAYMENT_PROVIDER_AUTHORIZE_PATH=/api/mock-payments/authorize
MOCK_PAYMENT_PROVIDER_DECLINED_AMOUNT=400.00
MOCK_PAYMENT_PROVIDER_TIMEOUT_AMOUNT=408.00
MOCK_PAYMENT_PROVIDER_5XX_AMOUNT=500.00
MOCK_PAYMENT_PROVIDER_TIMEOUT_SECONDS=5

PROMETHEUS_PORT=9090
JAEGER_UI_PORT=16686
OTLP_GRPC_PORT=4317
OTLP_HTTP_PORT=4318
OTEL_CONTAINER_EXPORTER_OTLP_TRACES_ENDPOINT=http://jaeger:4318/v1/traces
MANAGEMENT_TRACING_SAMPLING_PROBABILITY=1.0

FULL_STACK_SMOKE_TIMEOUT_SECONDS=1200
FULL_STACK_SMOKE_POLL_SECONDS=5
FULL_STACK_SMOKE_CURL_TIMEOUT_SECONDS=5
FULL_STACK_SMOKE_BUILD_MODE=missing

E2E_STACK_BUILD_MODE=always
E2E_COMPOSE_OVERRIDE_FILE=tests/e2e/docker-compose.e2e.yml
E2E_STACK_TIMEOUT_SECONDS=1200
E2E_TIMEOUT_SECONDS=900
E2E_POLL_SECONDS=2
E2E_CURL_TIMEOUT_SECONDS=120
E2E_KEYCLOAK_CURL_TIMEOUT_SECONDS=20
E2E_KEEP_KEYCLOAK_USERS=false
