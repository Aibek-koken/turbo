# Local-only Docker Compose placeholders.
# Copy to .env for personal overrides. Do not put production secrets here.

COMPOSE_PROJECT_NAME=ecommerce-local

POSTGRES_PORT=5432
POSTGRES_USER=ecommerce
POSTGRES_PASSWORD=change-me-local-postgres
POSTGRES_DB=ecommerce
ORDER_SERVICE_DATASOURCE_URL=jdbc:postgresql://localhost:5432/orders
ORDER_SERVICE_DATASOURCE_USERNAME=ecommerce
ORDER_SERVICE_DATASOURCE_PASSWORD=change-me-local-postgres
ORDER_SERVICE_CATALOG_BASE_URL=http://localhost:8081

REDIS_PORT=6379
REDIS_PASSWORD=change-me-local-redis
REDIS_HOST=localhost
REDIS_DATABASE=0
REDIS_TIMEOUT=PT2S
REDIS_CONNECT_TIMEOUT=PT2S
CATALOG_CACHE_ENABLED=true
CATALOG_PRODUCT_DETAIL_CACHE_TTL=PT10M
CATALOG_PRODUCT_DETAIL_CACHE_LOCK_WAIT=PT0.25S
CATALOG_PRODUCT_DETAIL_CACHE_LOCK_LEASE=PT5S
CATALOG_PRODUCT_DETAIL_CACHE_KEY_PREFIX=catalog:product-detail

KAFKA_PORT=9092
DEBEZIUM_CONNECT_PORT=8086

MONGO_PORT=27017
MONGO_INITDB_ROOT_USERNAME=ecommerce
MONGO_INITDB_ROOT_PASSWORD=change-me-local-mongo
MONGO_INITDB_DATABASE=audit

KEYCLOAK_PORT=8085
KEYCLOAK_MANAGEMENT_PORT=9000
KEYCLOAK_DB=keycloak
KEYCLOAK_REALM=ecommerce
KEYCLOAK_ISSUER_URI=http://localhost:8085/realms/ecommerce
KEYCLOAK_GATEWAY_CLIENT=ecommerce-gateway
KEYCLOAK_LOCAL_TEST_CLIENT=ecommerce-local-test
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-local-keycloak

PROMETHEUS_PORT=9090
JAEGER_UI_PORT=16686
OTLP_GRPC_PORT=4317
OTLP_HTTP_PORT=4318
